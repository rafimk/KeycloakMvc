{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/keycloakmvc-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Primary": {
      "DisplayName": "تسجيل الدخول عبر Keycloak الأول",
      "Description": "استخدم حسابك في الخادم الأول للمتابعة."
    },
    "Secondary": {
      "DisplayName": "تسجيل الدخول عبر Keycloak الثاني",
      "Description": "استخدم حسابك في الخادم الثاني للمتابعة."
    }
  },
  "Login": {
    "SessionTimeoutMinutes": 60,
    "PasswordLoginEnabled": false,
    "PasswordAttemptsPerMinute": 5
  },
  "ActiveDirectory": {
    "Domains": [
      {
        "Name": "Corporate",
        "Domain": "corp.example.com",
        "NetBiosName": "CORP",
        "Server": "dc01.corp.example.com",
        "Port": 636,
        "UseSsl": true,
        "TimeoutSeconds": 10,
        "RoleMappings": []
      },
      {
        "Name": "Operations",
        "Domain": "ops.example.com",
        "NetBiosName": "OPS",
        "Server": "dc01.ops.example.com",
        "Port": 636,
        "UseSsl": true,
        "TimeoutSeconds": 10,
        "RoleMappings": []
      }
    ]
  },
  "PermittedUsers": {
    "Keycloak": {
      "Primary": [],
      "Secondary": []
    },
    "ActiveDirectory": []
  }
}
