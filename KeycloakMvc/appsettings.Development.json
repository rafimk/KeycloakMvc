{
  "Keycloak": {
    "Primary": {
      "Authority": "http://localhost:8080/realms/mvc-sample",
      "ClientId": "mvc-app",
      "ClientSecret": "mvc-local-secret",
      "RequireHttpsMetadata": false,
      "KerberosAmrValue": "kerberos"
    },
    "Secondary": {
      "Authority": "http://localhost:8081/realms/mvc-secondary",
      "ClientId": "mvc-app",
      "ClientSecret": "mvc-secondary-local-secret",
      "RequireHttpsMetadata": false
    }
  },
  "FrameAncestors": [ "http://localhost:5500" ],
  "ActiveDirectory": {
    "Domains": [
      {
        "Name": "Lab",
        "Domain": "lab.test",
        "NetBiosName": "LAB",
        "Server": "dc1.lab.test",
        "Port": 636,
        "UseSsl": true,
        "TimeoutSeconds": 10,
        "RoleMappings": [
          { "Group": "CN=App Admins,CN=Users,DC=lab,DC=test", "Role": "Admin" }
        ]
      }
    ]
  },
  "PermittedUsers": {
    "Keycloak": {
      "Primary": [ "demo", "alice" ],
      "Secondary": [ "partner" ]
    },
    "ActiveDirectory": [ "alice@lab.test", "bob@lab.test" ]
  }
}
