@model LoginViewModel
@{ ViewData["Title"] = "Sign in with username and password"; }
<div class="auth-wrapper">
    <div class="card auth-card shadow-sm">
        <div class="card-body p-4 p-sm-5">
            <h1 class="h4 mb-1">Sign in</h1>
            <p class="text-muted mb-4">Use your Active Directory account.</p>

            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Domain" class="form-label"></label>
                    <select asp-for="Domain" asp-items="Model.Domains" class="form-select">
                        <option value="">Select a domain</option>
                    </select>
                    <span asp-validation-for="Domain" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Login</button>
                    <a class="btn btn-outline-secondary flex-grow-1" asp-controller="Account" asp-action="SelectAuthentication" asp-route-returnUrl="@Model.ReturnUrl">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
