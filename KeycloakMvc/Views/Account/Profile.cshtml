@{ ViewData["Title"] = "Your profile"; }
<h1>Your profile</h1>
<p>Signed in as <strong>@User.Identity?.Name</strong>. This page requires authentication.</p>
<table class="table table-striped">
    <thead><tr><th>Claim</th><th>Value</th></tr></thead>
    <tbody>
    @foreach (var claim in User.Claims.OrderBy(c => c.Type))
    {
        <tr><td>@claim.Type</td><td class="text-break">@claim.Value</td></tr>
    }
    </tbody>
</table>
<form asp-controller="Account" asp-action="Logout" method="post">
    <button class="btn btn-outline-secondary" type="submit">Sign out</button>
</form>
