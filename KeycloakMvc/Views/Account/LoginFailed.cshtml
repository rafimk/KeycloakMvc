@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign-in failed";
}
<div class="auth-header">
    <span class="auth-logo auth-logo--danger"><icon name="circle-alert" /></span>
    <h1 class="auth-title">Single sign-on did not complete</h1>
    <p class="auth-subtitle">We could not sign you in with your logged-in account. The sign-in may have been cancelled, or your Windows session could not be verified.</p>
</div>
<a class="btn-app btn-app--primary btn-app--block" asp-controller="Account" asp-action="SelectAuthentication">
    <icon name="arrow-left" />
    Back to sign-in options
</a>
