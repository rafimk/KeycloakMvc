@{ ViewData["Title"] = "Sign-in failed"; }
<div class="auth-wrapper">
    <div class="card auth-card shadow-sm">
        <div class="card-body p-4 p-sm-5 text-center">
            <h1 class="h4">Single sign-on did not complete</h1>
            <p class="text-muted">We could not sign you in with your logged-in account. The sign-in may have been cancelled, or your Windows session could not be verified.</p>
            <a class="btn btn-primary" asp-controller="Account" asp-action="SelectAuthentication">Back to sign-in options</a>
        </div>
    </div>
</div>
