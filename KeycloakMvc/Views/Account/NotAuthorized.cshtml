@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Not authorized";
}
<div class="auth-header">
    <span class="auth-logo auth-logo--danger"><icon name="shield-x" /></span>
    <h1 class="auth-title">Not authorized</h1>
    <p class="auth-subtitle">Your account was verified, but it is not permitted to use this application. Contact your administrator if you need access.</p>
</div>
<a class="btn-app btn-app--primary btn-app--block" asp-controller="Account" asp-action="SelectAuthentication">
    <icon name="arrow-left" />
    Back to sign-in options
</a>
