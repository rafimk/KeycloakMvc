@{ ViewData["Title"] = "Not authorized"; }
<div class="auth-wrapper">
    <div class="card auth-card shadow-sm">
        <div class="card-body p-4 p-sm-5 text-center">
            <h1 class="h4">Not authorized</h1>
            <p class="text-muted">Your account was verified, but it is not permitted to use this application. Contact your administrator if you need access.</p>
            <a class="btn btn-primary" asp-controller="Account" asp-action="SelectAuthentication">Back to sign-in options</a>
        </div>
    </div>
</div>
