@model SelectAuthenticationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<div class="auth-header">
    <span class="auth-logo"><icon name="shield-check" /></span>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Choose your preferred sign-in method to continue.</p>
</div>

<div class="auth-options">
    <form asp-controller="Account" asp-action="LoginWithLoggedUser" method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="auth-option" aria-describedby="option-sso-description">
            <span class="auth-option__icon"><icon name="monitor" /></span>
            <span class="auth-option__text">
                <span class="auth-option__title">Login with Logged-in User</span>
                <span class="auth-option__description" id="option-sso-description">Sign in securely using your Windows account.</span>
            </span>
            <icon name="chevron-right" />
        </button>
    </form>

    @if (Model.PasswordLoginEnabled)
    {
        <a class="auth-option" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl"
           aria-describedby="option-password-description">
            <span class="auth-option__icon"><icon name="key-round" /></span>
            <span class="auth-option__text">
                <span class="auth-option__title">Login with Username and Password</span>
                <span class="auth-option__description" id="option-password-description">Use your Active Directory credentials.</span>
            </span>
            <icon name="chevron-right" />
        </a>
    }
    else
    {
        <div class="auth-option is-disabled" aria-disabled="true">
            <span class="auth-option__icon"><icon name="key-round" /></span>
            <span class="auth-option__text">
                <span class="auth-option__title">Login with Username and Password</span>
                <span class="auth-option__description">No Active Directory domains are configured.</span>
            </span>
        </div>
    }
</div>

<p class="auth-note">
    <icon name="lock" />
    <span>Secure authentication powered by your organization's identity services.</span>
</p>
