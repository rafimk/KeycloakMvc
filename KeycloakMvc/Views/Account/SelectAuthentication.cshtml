@model SelectAuthenticationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    string[] icons = ["monitor", "server"];
}
<div class="auth-header">
    <span class="auth-logo"><icon name="shield-check" /></span>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Choose your preferred sign-in method to continue.</p>
</div>

<div class="auth-options">
    @for (var i = 0; i < Model.KeycloakInstances.Count; i++)
    {
        var option = Model.KeycloakInstances[i];
        var descriptionId = $"option-{option.Instance.ToLowerInvariant()}-description";
        <form asp-controller="Account" asp-action="LoginWithKeycloak" method="post">
            <input type="hidden" name="instance" value="@option.Instance" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="auth-option" aria-describedby="@(option.Description is null ? null : descriptionId)">
                <span class="auth-option__icon"><icon name="@icons[i % icons.Length]" /></span>
                @* dir="auto" lays the configured labels out right to left when they are Arabic. *@
                <span class="auth-option__text" dir="auto">
                    <span class="auth-option__title">@option.DisplayName</span>
                    @if (option.Description is not null)
                    {
                        <span class="auth-option__description" id="@descriptionId">@option.Description</span>
                    }
                </span>
                <icon name="chevron-right" />
            </button>
        </form>
    }
</div>

<p class="auth-note">
    <icon name="lock" />
    <span>Secure authentication powered by your organization's identity services.</span>
</p>
