@model HomeViewModel
@{ ViewData["Title"] = "Keycloak MVC sample"; }
<div class="text-center py-5">
    <h1 class="display-4">Welcome, @(Model.DisplayName ?? Model.UserName)</h1>
    <p class="lead">A .NET 10 MVC application with Keycloak and Active Directory sign-in.</p>
    <dl class="row justify-content-center text-start mx-auto my-4 home-details">
        <dt class="col-5">Username</dt>
        <dd class="col-7">@Model.UserName</dd>
        <dt class="col-5">Authentication</dt>
        <dd class="col-7">@Model.AuthenticationMethod</dd>
        @if (Model.IsActiveDirectory)
        {
            <dt class="col-5">Domain</dt>
            <dd class="col-7">@Model.Domain</dd>
        }
        else
        {
            <dt class="col-5">Identity provider</dt>
            <dd class="col-7">Keycloak <span class="d-block small text-muted text-break">@Model.Domain</span></dd>
        }
    </dl>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Profile">View your profile</a>
    <form class="mt-3" asp-controller="Account" asp-action="Logout" method="post">
        <button class="btn btn-outline-secondary" type="submit">Logout</button>
    </form>
</div>
