@{ ViewData["Title"] = "Keycloak MVC sample"; }
<div class="text-center py-5">
    <h1 class="display-4">MVC + Keycloak</h1>
    <p class="lead">A .NET 10 MVC application with OpenID Connect authentication.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Welcome, @User.Identity.Name!</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Profile">View your profile</a>
        <form class="mt-3" asp-controller="Account" asp-action="Logout" method="post">
            <button class="btn btn-outline-secondary" type="submit">Sign out</button>
        </form>
    }
    else
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in with Keycloak</a>
        <p class="mt-3 text-muted">Demo account: demo / Demo123!</p>
    }
</div>
