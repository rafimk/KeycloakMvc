{
  "realm": "mvc-sample",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [{
    "clientId": "mvc-app",
    "name": ".NET MVC sample",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "mvc-local-secret",
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["http://localhost:5000/signin-oidc"],
    "webOrigins": ["http://localhost:5000"],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "http://localhost:5000/signout-callback-oidc"
    },
    "defaultClientScopes": ["profile", "email", "roles", "web-origins"]
  }],
  "users": [{
    "username": "demo",
    "enabled": true,
    "emailVerified": true,
    "firstName": "Demo",
    "lastName": "User",
    "email": "demo@example.com",
    "credentials": [{"type": "password", "value": "Demo123!", "temporary": false}]
  }]
}
